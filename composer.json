{
  "name": "tai7sy/card-system",
  "description": "CardSystem open source edition",
  "keywords": [
    "card system free"
  ],
  "license": "MIT",
  "type": "project",
  "require": {
    "php": "^8.2",
    "ext-bcmath": "*",
    "ext-ctype": "*",
    "ext-curl": "*",
    "ext-dom": "*",
    "ext-fileinfo": "*",
    "ext-gd": "*",
    "ext-json": "*",
    "ext-libxml": "*",
    "ext-mbstring": "*",
    "ext-openssl": "*",
    "ext-pdo": "*",
    "ext-simplexml": "*",
    "ext-tokenizer": "*",
    "ext-xml": "*",
    "guzzlehttp/psr7": "^2.8",
    "hashids/hashids": "^4.1",
    "iidestiny/laravel-filesystem-oss": "^3.7",
    "laravel/framework": "^12.0",
    "laravel/helpers": "^1.8",
    "laravel/tinker": "^2.10",
    "laravel/ui": "^4.6",
    "league/flysystem-aws-s3-v3": "^3.0",
    "mews/captcha": "^3.4",
    "predis/predis": "^2.0",
    "rap2hpoutre/laravel-log-viewer": "^2.4",
    "tymon/jwt-auth": "^2.3",
    "voku/anti-xss": "4.0.1",
    "wi1dcard/alipay-sdk": "^1.3",
    "zgldh/qiniu-laravel-storage": "^9.0",
    "barryvdh/laravel-ide-helper": "^3.6"
  },
  "require-dev": {
    "filp/whoops": "~2.0",
    "mockery/mockery": "^1.6",
    "phpunit/phpunit": "^11.5",
    "fakerphp/faker": "^1.23",
    "laravel/legacy-factories": "^1.4"
  },
  "autoload": {
    "classmap": [
      "database/seeds",
      "database/factories"
    ],
    "psr-4": {
      "App\\": "app/",
      "Gateway\\": "app/Library/Gateway/"
    },
    "exclude-from-classmap": [
      "/app/Library/Gateway/"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "extra": {
    "aws/aws-sdk-php": [
      "S3",
      "Sqs"
    ],
    "laravel": {
      "dont-discover": [
        "iidestiny/laravel-filesystem-oss"
      ]
    }
  },
  "scripts": {
    "pre-autoload-dump": [
      "Aws\\Script\\Composer\\Composer::removeUnusedServices"
    ],
    "post-root-package-install": [
      "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
    ],
    "post-create-project-cmd": [
      "@php artisan key:generate"
    ],
    "post-autoload-dump": [
      "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
      "@php artisan package:discover"
    ],
    "deploy_for_test": [
      "echo 'Deploy for test'",
      "@composer install --no-dev",
      "@php artisan route:cache",
      "@php artisan config:cache"
    ],
    "dev": [
      "echo 'Local dev test'",
      "@composer install",
      "@composer dump-autoload --optimize",
      "@php artisan route:clear",
      "@php artisan config:clear",
      "@php artisan cache:clear"
    ],
    "ide": [
      "echo 'Generate IdeHelper...'",
      "@php artisan ide-helper:generate",
      "@php artisan ide-helper:meta",
      "echo | @php artisan ide-helper:models"
    ],
    "db": [
      "echo ' * Update the database...'",
      "@php artisan migrate"
    ],
    "db_rebuild": [
      "echo ' * Rebuild the database...'",
      "@php artisan migrate:fresh --seed",
      "@php artisan cache:clear"
    ],
    "update_vendor": [
      "@composer update --optimize-autoloader"
    ],
    "build": [
      "Composer\\Config::disableProcessTimeout",
      "@php scripts/build-release.php"
    ],
    "test": "@php -d error_reporting=8191 vendor/bin/phpunit",
    "test:aws": "@php tests/aws-storage.php"
  },
  "config": {
    "preferred-install": "dist",
    "sort-packages": true,
    "optimize-autoloader": true,
    "platform": {
      "php": "8.2.0"
    },
    "allow-plugins": {
      "php-http/discovery": true
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
